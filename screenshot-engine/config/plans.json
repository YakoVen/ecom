{
  "$comment": "Plan definitions for the screenshot library. Routes are derived from actual page.tsx files. Dynamic routes marked requireDynamic: true need a real ID resolved at runtime; provide a fallbackId.",
  "commonAuth": {
    "emailField": "#email",
    "passwordField": "#password",
    "submitButton": "button[type=\"submit\"]",
    "successSignal": "email field disappears",
    "fallbackCredentials": {
      "email": "admin@store.com",
      "password": "password123",
      "$comment": "Used when the plan has no NEXT_PUBLIC_ADMIN_TEST_EMAIL/PASSWORD in .env.local"
    }
  },
  "plans": [
    {
      "id": "beginner",
      "label": "Beginner",
      "dir": "beginner-plan",
      "appDir": "app",
      "port": 3100,
      "auth": {
        "mode": "inline-dashboard",
        "loginUrl": "/dashboard",
        "note": "No /login page. Login form renders inside the dashboard layout when unauthenticated."
      },
      "pages": [
        { "route": "/", "name": "home", "group": "storefront", "requiresAuth": false },
        { "route": "/articles", "name": "articles", "group": "storefront", "requiresAuth": false },
